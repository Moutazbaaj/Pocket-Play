-- PocketPlay SDK 1
-- Title: Unit Converter

local background = app.rgb(13, 20, 33)
local panel = app.rgb(23, 37, 57)
local bright = app.rgb(232, 240, 251)
local muted = app.rgb(157, 176, 203)
local accent = app.rgb(124, 224, 179)
local labels = {"TEMPERATURE", "LENGTH", "WEIGHT"}
local from = {"C", "CM", "KG"}
local to = {"F", "IN", "LB"}
local category = 1
local reverse = false
local value = 0
local dirty = true

local function roundRatio(numerator, denominator)
  local result = (math.abs(numerator) + denominator // 2) // denominator
  return numerator < 0 and -result or result
end

local function convert()
  if category == 1 then
    if reverse then return roundRatio((value - 32) * 500, 9) end
    return value * 180 + 3200
  elseif category == 2 then
    if reverse then return value * 254 end
    return roundRatio(value * 10000, 254)
  else
    if reverse then return roundRatio(value * 453592, 10000) end
    return roundRatio(value * 220462, 1000)
  end
end

local function decimal(hundredths)
  local magnitude = math.abs(hundredths)
  local digits = magnitude % 100
  return (hundredths < 0 and "-" or "") .. (magnitude // 100) .. "." .. (digits < 10 and "0" or "") .. digits
end

function update(dt, pressed, held)
  if (pressed & app.UP) ~= 0 then
    category = (category + 1) % 3 + 1
  elseif (pressed & app.DOWN) ~= 0 then
    category = category % 3 + 1
  elseif (pressed & app.A) ~= 0 then
    reverse = not reverse
  elseif (pressed & app.B) ~= 0 then
    value = 0
  else
    local step = ((pressed & app.RIGHT) ~= 0 and 1 or 0) - ((pressed & app.LEFT) ~= 0 and 1 or 0)
    step = step + ((pressed & app.R) ~= 0 and 10 or 0) - ((pressed & app.L) ~= 0 and 10 or 0)
    if step == 0 then return end
    value = value + step
  end
  value = math.max(category == 1 and -999 or 0, math.min(999, value))
  dirty = true
end

function draw(full)
  if full then
    app.fill(0, 0, 320, 38, panel)
    app.text(16, 11, "Unit Converter", bright, panel, 2)
    app.text(16, 192, "A: SWAP  B: ZERO  UP/DOWN: UNITS", muted, 0)
    app.text(16, 207, "LEFT/RIGHT: +/-1   L/R: +/-10", muted, 0)
  end
  if not (full or dirty) then return end
  app.fill(16, 48, 288, 132, background)
  app.text(28, 58, labels[category], accent, background)
  local inputUnit = reverse and to[category] or from[category]
  local resultUnit = reverse and from[category] or to[category]
  app.text(28, 86, "INPUT", muted, background)
  app.text(120, 80, tostring(value) .. " " .. inputUnit, bright, background, 2)
  app.fill(28, 110, 264, 1, panel)
  app.text(28, 139, "RESULT", muted, background)
  app.text(120, 133, decimal(convert()) .. " " .. resultUnit, accent, background, 2)
  dirty = false
end
